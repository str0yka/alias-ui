#!/bin/sh

# Run lint
echo "Running linter..."
pnpm lint
if [ $? -ne 0 ]; then
  echo "Linting failed. Commit aborted."
  exit 1
fi

# Run type checking
echo "Running type check..."
pnpm run check-types
if [ $? -ne 0 ]; then
  echo "Type checking failed. Commit aborted."
  exit 1
fi

# Run tests
echo "Running tests..."
pnpm test
if [ $? -ne 0 ]; then
  echo "Tests failed. Commit aborted."
  exit 1
fi

# Add updated snapshots
echo "Searching for updated snapshots..."
SNAPSHOTS=$(find . -type d -name "__snapshots__" | xargs -I {} git add {} || true)

if [ -n "$SNAPSHOTS" ]; then
  echo "Added updated snapshots to commit."
else
  echo "No updated snapshots found."
fi

echo "Linting, type checking, and tests passed. Proceeding with commit."
